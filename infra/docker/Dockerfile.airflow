FROM apache/airflow:3.2.1-python3.11

# Install project dependencies needed by DAGs at runtime
RUN pip install --no-cache-dir \
    "MLB-StatsAPI>=1.7" \
    "pybaseball>=2.2" \
    "sqlalchemy>=2.0,<3.0" \
    "psycopg2-binary>=2.9,<3.0" \
    "pydantic>=2.0,<3.0" \
    "pydantic-settings>=2.0,<3.0" \
    "pandas>=2.0,<3.0" \
    "numpy>=1.24,<3.0" \
    "httpx>=0.27,<1.0" \
    "tenacity>=8.0,<10.0"
