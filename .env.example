# Copy to .env and fill in. .env is gitignored.

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/diamond_copilot
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Yahoo Fantasy Sports OAuth ---
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:3000/api/auth/callback/yahoo

# --- Anthropic (Phase 6 chatbot) ---
ANTHROPIC_API_KEY=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Prefect ---
PREFECT_API_URL=
PREFECT_API_KEY=

# --- Sentry (Phase 4) ---
SENTRY_DSN=

# --- Misc ---
ENVIRONMENT=development  # development | staging | production
LOG_LEVEL=INFO
